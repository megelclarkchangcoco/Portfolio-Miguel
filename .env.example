# Copy this file's variables into your Vercel project settings
# (Project -> Settings -> Environment Variables). Do NOT commit a real .env file.

# Get this from https://resend.com after creating a free account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form messages should be delivered.
TO_EMAIL=mcpolison@email.com

# Sender shown in the email. Resend's shared test address works with no
# domain setup. Once you verify your own domain on Resend, switch this to
# something like: Portfolio Contact <contact@yourdomain.com>
FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
